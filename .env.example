# Copy to .env and adjust for local development.
# On Cloud Run, these variables are set on the service / Secret Manager -
# see README.md, do not use this file in production.

DATABASE_URL=postgresql://ticketbridge:ticketbridge@localhost:5432/ticketbridge
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
SYNC_BATCH_SIZE=20
# In-process scheduler: triggers outbox sync automatically, no external
# pinger (e.g. Cloud Scheduler) required. Set to false to disable it and
# drive sync purely via POST /api/v1/sync instead.
SYNC_SCHEDULER_ENABLED=true
SYNC_INTERVAL_SECONDS=120
OUTBOUND_TIMEOUT_SECONDS=10
SCHEDULER_SHARED_SECRET=a-long-random-key-for-local-use-only

# Admin frontend session cookie (see app/api/auth.py, CLAUDE.md Decision
# 11). SESSION_COOKIE_NAME is only cosmetic; SESSION_LIFETIME_HOURS
# controls how long an admin stays logged in before needing to sign in
# again.
SESSION_COOKIE_NAME=ticket_bridge_session
SESSION_LIFETIME_HOURS=12
# Failed logins allowed per username within LOGIN_LOCKOUT_MINUTES before
# further attempts for that username are rejected with 429.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

LOG_LEVEL=INFO
ENVIRONMENT=local

# Path prefix to serve under, for a reverse proxy (e.g. HAProxy) that
# mounts the app at e.g. /ticket-bridge and strips that prefix before
# forwarding - see README.md section 3.6.1. "/" means no prefix (served
# at the domain root) - also the Dockerfile's own baked-in default, so
# this only needs to change when actually running behind such a proxy.
# Read by the Dockerfile's CMD (docker run - section 3.5 - and
# docker-compose.yml, which loads this same file via `env_file: .env`).
# Not consumed by local `uv run uvicorn` (section 3.2) - nothing sits in
# front of it locally, so there's no prefix to account for.
ROOT_PATH=/

# Key for encrypting outbound secrets entered in the frontend (a system's
# "Outbound secret" field - CLAUDE.md Decision 13, README.md "Outbound
# secrets"). Set once per deployment and keep it: changing or losing it
# means re-entering every stored secret. Generate one with any of:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   docker compose run --rm --no-deps app python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   openssl rand -base64 32 | tr '+/' '-_'
# Empty = the frontend can't store secrets (secret_ref below still works).
SECRETS_ENCRYPTION_KEY=

# Secrets referenced by name (auth_config.secret_ref), resolved from an
# environment variable whatever ENVIRONMENT is, before trying Secret
# Manager. The variable name is the system's auth_config.secret_ref,
# UPPERCASED (resolve_secret() does secret_ref.upper() - see
# app/services/secrets.py) - secret_ref itself
# stays lowercase-with-underscores to match Secret Manager's own naming
# convention. These two match the sample seed's secret_ref values
# ('system_a_outbound_key' / 'system_b_outbound_token' - see
# migrations/002_seed_example.sql).
SYSTEM_A_OUTBOUND_KEY=dev-secret-a
SYSTEM_B_OUTBOUND_TOKEN=dev-secret-b
