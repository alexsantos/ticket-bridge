# Copy to .env and adjust for local development.
# On Cloud Run, these variables are set on the service / Secret Manager -
# see README.md, do not use this file in production.

DATABASE_URL=postgresql://ticketbridge:ticketbridge@localhost:5432/ticketbridge
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
SYNC_BATCH_SIZE=20
OUTBOUND_TIMEOUT_SECONDS=10
SCHEDULER_SHARED_SECRET=a-long-random-key-for-local-use-only
LOG_LEVEL=INFO
ENVIRONMENT=local

# Secrets resolved via environment variable in 'local' mode
# (names used in the sample seed - see migrations/002_seed_example.sql).
SYSTEM_A_OUTBOUND_KEY=dev-secret-a
SYSTEM_B_OUTBOUND_TOKEN=dev-secret-b
