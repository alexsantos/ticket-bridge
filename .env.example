# Copy to .env and adjust for local development.
# On Cloud Run, these variables are set on the service / Secret Manager -
# see README.md, do not use this file in production.

DATABASE_URL=postgresql://ticketbridge:ticketbridge@localhost:5432/ticketbridge
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
SYNC_BATCH_SIZE=20
# In-process scheduler: triggers outbox sync automatically, no external
# pinger (e.g. Cloud Scheduler) required. Set to false to disable it and
# drive sync purely via POST /api/v1/sync instead.
SYNC_SCHEDULER_ENABLED=true
SYNC_INTERVAL_SECONDS=120
OUTBOUND_TIMEOUT_SECONDS=10
SCHEDULER_SHARED_SECRET=a-long-random-key-for-local-use-only
LOG_LEVEL=INFO
ENVIRONMENT=local

# Secrets resolved via environment variable in 'local' mode. The name must
# match the system's auth_config.secret_ref EXACTLY, including case -
# resolve_secret() does a case-sensitive os.environ lookup (see
# app/services/secrets.py). These two match the sample seed's secret_ref
# values (see migrations/002_seed_example.sql).
system_a_outbound_key=dev-secret-a
system_b_outbound_token=dev-secret-b
