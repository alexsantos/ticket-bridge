# Copiar para .env e ajustar para desenvolvimento local.
# Em Cloud Run, estas variáveis são definidas no serviço / Secret Manager -
# ver README.md, não usar este ficheiro em produção.

DATABASE_URL=postgresql://ticketbridge:ticketbridge@localhost:5432/ticketbridge
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
SYNC_BATCH_SIZE=20
OUTBOUND_TIMEOUT_SECONDS=10
SCHEDULER_SHARED_SECRET=uma-chave-longa-e-aleatoria-apenas-local
LOG_LEVEL=INFO
ENVIRONMENT=local

# Segredos resolvidos via variável de ambiente em modo 'local'
# (nomes usados no seed de exemplo - ver migrations/002_seed_example.sql).
SISTEMA_A_OUTBOUND_KEY=dev-secret-a
SISTEMA_B_OUTBOUND_TOKEN=dev-secret-b
